# dependencies
node_modules/

# pnpm local store/cache + sandbox HOME/XDG redirection (see README "Dev environment")
.pnpm-store/
.pnpm-cache/
.pnpm-state/
.npm-cache/
.home/
.run/
.tmp/
.xdg/

# local runtime state (never commit: evidence images, ledger, task records)
.price-agent/

# build / test artifacts
dist/
coverage/
*.tsbuildinfo
*.log

# tesseract 语言模型（5MB 二进制，运行时自动下载到 .price-agent/ocr-cache；不入库）
eng.traineddata
*.traineddata

# fixtures: keep only redacted, small samples; ignore raw captures
test/fixtures/**/*.raw.png
test/fixtures/**/*.raw.xml

# editor / OS
.DS_Store
.idea/
.vscode/

# local runtime DSH homes
.dshweb/
.dshrun/
.dshp/
.dshm/
.dshv/
