  },
  "optionalDependencies": {
    "tesseract.js": "^5",
    "fast-xml-parser": "^4"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
